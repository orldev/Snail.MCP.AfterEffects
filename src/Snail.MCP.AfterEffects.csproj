<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Sdk Name="Snail.Sdk.Mcp" />

    <!--
        Framework-dependent, as the Razor pages and the reflection they run on keep it out of Native AOT; stdio beside
        After Effects, and HTTP for the image docker/server/Dockerfile builds. Snail.Sdk.Mcp sets the rest: a dotnet tool
        of the McpServer kind, Install into ~/.s3l-mcp.
    -->
    <PropertyGroup>
        <!--
            Said here rather than left to Snail.Sdk.Mcp, because this project takes Microsoft.NET.Sdk.Razor as its SDK and brings the
            Snail one in with an Sdk element, whose targets are imported after Microsoft.NET.Sdk.targets. That file imports the .NET
            SDK's tool packaging only when PackAsTool already reads true, so set later it is never read: the package came out with no
            tools folder and no DotnetToolSettings.xml, and nuget.org refused it for carrying the McpServer type without DotnetTool
            (a 400 on the push of 0.1.0-preview.2). Set here, in the body of the project, it is read in time.
        -->
        <PackAsTool>true</PackAsTool>
        <!-- Named here for the same reason: the .NET SDK's tool packaging defaults the command to the assembly name before Snail.Sdk.Mcp
             is imported, and its own s3l-mcp-<short> then finds the property already set. -->
        <ToolCommandName>s3l-mcp-aftereffects</ToolCommandName>
        <SnailMcpNative>false</SnailMcpNative>
        <SnailMcpTransport>Both</SnailMcpTransport>
        <SnailMcpContainer>true</SnailMcpContainer>
        <!-- The tool reference goes where MkDocs reads the site: docs/content/tools and docs/content/schemas. -->
        <SnailReferenceFolder>$(MSBuildProjectDirectory)/../docs/content</SnailReferenceFolder>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.1.0</Version>
        <Description>MCP server that lets AI agents drive a running Adobe After Effects through its ExtendScript bridge: projects, compositions, layers, properties, keyframes, expressions, effects, text, shapes and rendering. Runs over stdio beside After Effects on this machine.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;claude;after-effects;adobe;motion-graphics;dotnet-tool</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.AfterEffects</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.AfterEffects</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Jint" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\extension\**\*" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(SnailSiteTheme)css/site.css" LogicalName="assets/site.css" Visible="false" />
        <EmbeddedResource Include="Web\Pages\Assets\pages.css" LogicalName="assets/pages.css" />
        <EmbeddedResource Include="Web\Pages\Assets\pages.js" LogicalName="assets/pages.js" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.AfterEffects.Tests" />
        <InternalsVisibleTo Include="Snail.MCP.AfterEffects.Benchmarks" />
    </ItemGroup>

</Project>
